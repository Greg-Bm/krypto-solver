cabal-version:      3.0
name:               krypto-solver
version:            0.1.0.0
synopsis:
  Solver for games such as Krypto and 24. It provides functionality to enumerate all solutions that are unique up to an equivalence relation generated by the reflexive symmetric transitive closure of a provided relation.

description: Solver for Krypto, 24 and similar games.
license:            BSD-3-Clause
license-file:       LICENSE
author:             gb
maintainer:         gb@example.com
-- copyright:
category:           Game
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable krypto-solver
    import:           warnings
    main-is:          Main.hs
    -- other-extensions:
    build-depends:    base ^>=4.20.2.0,
                      ghc >= 9.10.3,
                      krypto-solver,
    hs-source-dirs:   app
    default-language: Haskell2010

library
  hs-source-dirs: src
  exposed-modules: EquivRep, Expr, Relation, Solver
  default-extensions: ImportQualifiedPost
  build-depends:
                base,
                containers,
                deepseq,
                union-find-array

benchmark benchmark
  type:               exitcode-stdio-1.0
  default-extensions: ImportQualifiedPost
  hs-source-dirs:     benchmark
  main-is:            Main.hs
  other-modules:      KSBench
  build-depends:
    , async           >=2.2.6 && <2.3
    , base
    , deepseq         >=1.4.8 && <1.6
    , random
    , tasty           >=1.5.4 && <1.6
    , tasty-bench     >=0.5   && <0.6
    , krypto-solver
